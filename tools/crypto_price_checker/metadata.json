{
  "name": "crypto_price_checker",
  "display_name": "Crypto Price Checker",
  "description": "Fetches live cryptocurrency market prices, 24h change, and market cap in USD using the free CoinGecko API.",
  "category": "Finance",
  "language": "python",
  "mcp_compatible": true,
  "author": {
    "name": "Tarun Jalandhara",
    "github": "tarunjandra"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "coin_id": {
        "type": "string",
        "description": "Cryptocurrency ID (e.g. bitcoin, ethereum, solana, dogecoin)",
        "default": "bitcoin"
      },
      "currency": {
        "type": "string",
        "description": "Target fiat/crypto currency (default 'usd')",
        "default": "usd"
      }
    },
    "required": ["coin_id"]
  },
  "env_vars": []
}
